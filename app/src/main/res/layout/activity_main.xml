<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER BAR WITH LOGO AND STATS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name"
                android:layout_marginEnd="10dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTrainedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#00E5FF"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1A2030"
                app:cardCornerRadius="16dp"
                app:strokeColor="#2A354C"
                app:strokeWidth="1dp">
                <TextView
                    android:id="@+id/txtBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="🔋 --%"
                    android:textColor="#81D4FA"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- CONNECTION & PUSH-TO-GESTURE BANNER -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#161B27"
            app:cardCornerRadius="14dp"
            app:strokeColor="#242C3E"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/status_disconnected"
                            android:textColor="#EF5350"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtConnectedDevice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#80DEEA"
                            android:textSize="11sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeviceManager"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="@string/device_manager_btn"
                        android:textColor="#00E5FF"
                        app:cornerRadius="10dp"
                        app:strokeColor="#00E5FF"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConnect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_connect"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#00C853"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#242C3E" />

                <!-- PUSH-TO-GESTURE STATUS PILL -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/bannerGestureStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1E2536"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="#2E394E"
                    app:strokeWidth="1dp">
                    <TextView
                        android:id="@+id/txtGestureHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="11dp"
                        android:text="@string/gesture_hint_idle"
                        android:textColor="#80DEEA"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/double_click_hint"
                    android:textColor="#607D8B"
                    android:textSize="11sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ACTION TILES -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:columnCount="3">

            <!-- PREV -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPrev"
                android:layout_width="0dp"
                android:layout_height="94dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                app:cardBackgroundColor="#161B27"
                app:cardCornerRadius="12dp"
                app:strokeColor="#242C3E"
                app:strokeWidth="1.5dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏮" android:textSize="24sp" android:textColor="#00E5FF"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/action_prev" android:textColor="#ECEFF1" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
                    <TextView android:id="@+id/txtPrevConf" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--%" android:textColor="#546E7A" android:textSize="10sp" android:layout_marginTop="2dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PLAY/PAUSE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPlayPause"
                android:layout_width="0dp"
                android:layout_height="94dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                app:cardBackgroundColor="#161B27"
                app:cardCornerRadius="12dp"
                app:strokeColor="#242C3E"
                app:strokeWidth="1.5dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏯" android:textSize="24sp" android:textColor="#00E676"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/action_play_pause" android:textColor="#ECEFF1" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
                    <TextView android:id="@+id/txtPlayConf" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/double_click_badge" android:textColor="#546E7A" android:textSize="10sp" android:layout_marginTop="2dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- NEXT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNext"
                android:layout_width="0dp"
                android:layout_height="94dp"
                android:layout_columnWeight="1"
                android:layout_margin="3dp"
                app:cardBackgroundColor="#161B27"
                app:cardCornerRadius="12dp"
                app:strokeColor="#242C3E"
                app:strokeWidth="1.5dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏭" android:textSize="24sp" android:textColor="#00E5FF"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/action_next" android:textColor="#ECEFF1" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="2dp"/>
                    <TextView android:id="@+id/txtNextConf" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--%" android:textColor="#546E7A" android:textSize="10sp" android:layout_marginTop="2dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <!-- LIVE SENSORS (PREMIUM GLASS-CARD) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#161B27"
            app:cardCornerRadius="14dp"
            app:strokeColor="#242C3E"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sensors_title"
                    android:textColor="#78909C"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <!-- 1. ACCELEROMETER BLOCK -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A2030"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="#283348"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/accel_section" android:textColor="#00E676" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/txtTotalG" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.00 G" android:textColor="#00E676" android:textStyle="bold" android:textSize="13sp"/>
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pbTotalG"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="10dp"
                            android:max="500"
                            android:progress="100"/>

                        <!-- Accel X, Y, Z -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                            <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Accel X" android:textColor="#78909C" android:textSize="11sp"/>
                            <ProgressBar android:id="@+id/pbAccelX" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_gravity="center_vertical" android:max="600" android:progress="300"/>
                            <TextView android:id="@+id/txtAccelX" android:layout_width="65dp" android:layout_height="wrap_content" android:text="0.00 G" android:textColor="#ECEFF1" android:textSize="11sp" android:gravity="end"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                            <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Accel Y" android:textColor="#78909C" android:textSize="11sp"/>
                            <ProgressBar android:id="@+id/pbAccelY" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_gravity="center_vertical" android:max="600" android:progress="300"/>
                            <TextView android:id="@+id/txtAccelY" android:layout_width="65dp" android:layout_height="wrap_content" android:text="0.00 G" android:textColor="#ECEFF1" android:textSize="11sp" android:gravity="end"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Accel Z" android:textColor="#78909C" android:textSize="11sp"/>
                            <ProgressBar android:id="@+id/pbAccelZ" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_gravity="center_vertical" android:max="600" android:progress="400"/>
                            <TextView android:id="@+id/txtAccelZ" android:layout_width="65dp" android:layout_height="wrap_content" android:text="1.00 G" android:textColor="#ECEFF1" android:textSize="11sp" android:gravity="end"/>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. GYROSCOPE BLOCK -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#1A2030"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="#283348"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/gyro_section" android:textColor="#00E5FF" android:textSize="11sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/txtTotalGyro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 °/s" android:textColor="#00E5FF" android:textStyle="bold" android:textSize="13sp"/>
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pbTotalGyro"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="10dp"
                            android:max="500"
                            android:progress="0"/>

                        <!-- Gyro X, Y, Z -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                            <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Gyro X" android:textColor="#78909C" android:textSize="11sp"/>
                            <ProgressBar android:id="@+id/pbGyroX" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_gravity="center_vertical" android:max="1000" android:progress="500"/>
                            <TextView android:id="@+id/txtGyroX" android:layout_width="65dp" android:layout_height="wrap_content" android:text="0.0 °/s" android:textColor="#ECEFF1" android:textSize="11sp" android:gravity="end"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
                            <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Gyro Y" android:textColor="#78909C" android:textSize="11sp"/>
                            <ProgressBar android:id="@+id/pbGyroY" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_gravity="center_vertical" android:max="1000" android:progress="500"/>
                            <TextView android:id="@+id/txtGyroY" android:layout_width="65dp" android:layout_height="wrap_content" android:text="0.0 °/s" android:textColor="#ECEFF1" android:textSize="11sp" android:gravity="end"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Gyro Z" android:textColor="#78909C" android:textSize="11sp"/>
                            <ProgressBar android:id="@+id/pbGyroZ" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_gravity="center_vertical" android:max="1000" android:progress="500"/>
                            <TextView android:id="@+id/txtGyroZ" android:layout_width="65dp" android:layout_height="wrap_content" android:text="0.0 °/s" android:textColor="#ECEFF1" android:textSize="11sp" android:gravity="end"/>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. BUTTON STATE BLOCK -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#1A2030"
                    app:cardCornerRadius="10dp"
                    app:strokeColor="#283348"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/button_section" android:textColor="#78909C" android:textSize="11sp" android:textStyle="bold"/>
                        <TextView
                            android:id="@+id/txtButtonStateBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#2E394E"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="5dp"
                            android:text="@string/button_state_released"
                            android:textColor="#ECEFF1"
                            android:textSize="11sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
